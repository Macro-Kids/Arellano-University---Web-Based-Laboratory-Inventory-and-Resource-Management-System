# Copy to .env and edit. Every setting is optional — defaults work for development.
# (All settings are read in ONE place: server/config.js)

PORT=3000
# NODE_ENV=production            # production: no demo data, secure cookies, quieter logs
# DB_PATH=data/aulab.sqlite
# BACKUP_DIR=data/backups
# APP_TIMEZONE=Asia/Manila       # decides when "overdue" flips (local midnight)

# --- first run -------------------------------------------------------------------
# SEED_DEMO=1                    # load the demo dataset on an empty database (default: on in development)
# SHOW_DEMO_LOGINS=1             # show one-click demo accounts on the sign-in page (default: on in development)
# DEMO_PASSWORD=Demo@2026
# ADMIN_USERNAME=admin           # production first-run administrator
# ADMIN_INITIAL_PASSWORD=        # empty = generated and printed once in the log

# --- sessions & security ----------------------------------------------------------
# SESSION_TTL_HOURS=12
# COOKIE_SECURE=1                # forced on in production; needs HTTPS
# TRUST_PROXY=1                  # set when behind an HTTPS reverse proxy (nginx, Caddy…)
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15

# --- backups ----------------------------------------------------------------------
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION=14

# --- debugging --------------------------------------------------------------------
# LOG_LEVEL=debug                # error | warn | info | debug
# DEBUG_SQL=1                    # log every SQL statement (very verbose)
# LOG_TO_FILE=1                  # logs/app.log (JSON lines)
